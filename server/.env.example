# Server configuration for ChaiBook
PORT=8080

# PostgreSQL database URL (default: postgresql://postgres:postgres@localhost:5434/chaibook)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/chaibook

# Better Auth (authentication) — create a project in Better Auth → Settings → API Keys
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Google OAuth credentials — create a project in Google Cloud Console → APIs & Services → Credentials → Create Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (PDF uploads) — unsigned upload preset from Dashboard → Upload → Upload Presets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Optional: signed download URLs for re-processing PDFs uploaded before inline extraction
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firecrawl (website imports)
FIRECRAWL_API_KEY=

# Mem0 (conversation memory; optional)
MEM0_API_KEY=

# Inngest (local dev — run `npx inngest-cli@latest dev` alongside the server)
INNGEST_DEV=1

# OpenAI — gpt-4o-mini for chat, text-embedding-3-small (1536 dims) for Pinecone
OPENAI_API_KEY=

# Pinecone — index is auto-created with 1536 dimensions (cosine) if missing
PINECONE_API_KEY=
PINECONE_INDEX=chaibook

# Tavily (web search; optional)
TAVILY_API_KEY=
